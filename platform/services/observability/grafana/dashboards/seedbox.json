          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(hash:qbittorrent_torrent_tracker:info, tracker)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
